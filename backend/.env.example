# Copy this file to ".env" (same folder) and fill it in. ".env" is private: never commit it, never paste it into a chat.

# ── Pandu AI (Google Gemini) ─────────────────────────────
# Get a free key at https://aistudio.google.com/apikey then paste it after the equals sign (no quotes).
GEMINI_API_KEY=
# The model Pandu talks to. gemini-3.8-flash is fast and smart; gemini-3.5-flash-lite is the cheapest.
GEMINI_MODEL=gemini-3.8-flash
# If that model is ever unavailable, these are tried in order.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# 1 = let Pandu use Google Search for current facts (prime ministers, news, prices). 0 = never.
GEMINI_GROUNDING=1

# ── Your trained SVM ─────────────────────────────────────
# A scikit-learn Pipeline saved with joblib.dump(pipeline, "churn_svm.joblib"). Put the file at this path.
MODEL_PATH=model/churn_svm.joblib
# Columns the front end sends that your model was NOT trained on (comma separated).
DROP_COLUMNS=customerID
# The label that means "churned" if your classes are text (for example Yes / No). Numbers (1) work automatically.
POSITIVE_CLASS=Yes
